{
  "compilerOptions": {
    "allowJs": false,
    "jsx": "react",
    "lib": ["dom", "esnext"],
    "moduleResolution": "node",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["jest", "react", "react-native"]
  },
  "include": ["App.tsx", "src/**/*"],
  "exclude": ["node_modules"]
}
